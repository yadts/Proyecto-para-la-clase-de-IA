**`test.sh`**: pruebas de humo

```bash
#!/usr/bin/env bash
cd "$(dirname "$0")/.."
set -a; source .env; set +a
FAIL=0
ok() { printf '[ OK  ] %s\n' "$1"; }
ko() { printf '[FALLO] %s\n' "$1"; FAIL=1; }
http() { local n="$1" u="$2"; shift 2
  if curl -fsS -m 15 -o /dev/null "$@" "$u"; then ok "$n -> $u"; else ko "$n -> $u"; fi; }

echo "== 1. Contenedores en ejecución =="
for c in ollama rag searxng comfyui yolo openwebui hermes-agent opencode; do
  if [ "$(docker inspect -f '{{.State.Running}}' "$c" 2>/dev/null)" = "true" ]; then ok "$c"; else ko "$c no está en ejecución"; fi
done

echo "== 2. Servicios HTTP desde el host =="
http Ollama    "http://localhost:${OLLAMA_PORT}/api/tags"
http OpenWebUI "http://localhost:${OPENWEBUI_PORT}/health"
http ComfyUI   "http://localhost:${COMFYUI_PORT}/system_stats"
http YOLO      "http://localhost:${YOLO_PORT}/health"
http SearXNG   "http://localhost:${SEARXNG_PORT}/search?q=prueba&format=json"
http RAG       "http://localhost:${RAG_PORT}/collections" -H "api-key: ${RAG_API_KEY}"
http OpenCode  "http://localhost:${OPENCODE_PORT}/" -u "${OPENCODE_SERVER_USERNAME}:${OPENCODE_SERVER_PASSWORD}"

echo "== 3. GPU visible dentro de los contenedores =="
for c in ollama comfyui yolo openwebui; do
  if docker exec "$c" nvidia-smi -L >/dev/null 2>&1; then ok "$c ve la GPU"; else ko "$c NO ve la GPU"; fi
done
if curl -fsS "http://localhost:${YOLO_PORT}/health" | grep -q '"cuda":true'; then ok "YOLO usa CUDA"; else ko "YOLO no usa CUDA"; fi

echo "== 4. DNS interno de red-ia =="
if docker exec openwebui python3 -c "import urllib.request as u;u.urlopen('http://ollama:11434/api/tags',timeout=10)" 2>/dev/null; then ok "openwebui -> ollama"; else ko "openwebui -> ollama"; fi
if docker exec openwebui python3 -c "import urllib.request as u;u.urlopen('http://searxng:8080/search?q=a&format=json',timeout=20)" 2>/dev/null; then ok "openwebui -> searxng"; else ko "openwebui -> searxng"; fi
if docker exec openwebui python3 -c "import urllib.request as u;u.urlopen('http://comfyui:8188/system_stats',timeout=10)" 2>/dev/null; then ok "openwebui -> comfyui"; else ko "openwebui -> comfyui"; fi
if docker exec opencode curl -fsS -m 10 -o /dev/null http://ollama:11434/api/tags; then ok "opencode -> ollama"; else ko "opencode -> ollama"; fi
if docker exec opencode curl -fsS -m 20 -o /dev/null "http://searxng:8080/search?q=a&format=json"; then ok "opencode -> searxng"; else ko "opencode -> searxng"; fi

echo
[ "$FAIL" -eq 0 ] && echo "RESULTADO: todo correcto" || echo "RESULTADO: hay fallos (revise los logs: docker logs <contenedor>)"
exit "$FAIL"
```

**`backup.sh`**: copia de seguridad (ver sección 6.2)

```bash
#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
set -a; source .env; set +a

DEST="$PROJECT_DIR/backups"
STAMP=$(date +%F_%H%M)
mkdir -p "$DEST"

# Parar los servicios que escriben bases de datos para obtener una copia consistente
restart() { docker start openwebui rag >/dev/null 2>&1 || true; }
trap restart EXIT
docker stop openwebui rag >/dev/null 2>&1 || true

# Datos (se excluyen los modelos: pesan mucho y se pueden volver a descargar)
tar czf "$DEST/ia-datos_${STAMP}.tar.gz" -C "$DATA_DIR" \
  --exclude='ollama/models' --exclude='comfyui/models' \
  openwebui hermes opencode comfyui yolo searxng rag ollama

# Configuración del stack
tar czf "$DEST/ia-config_${STAMP}.tar.gz" -C "$PROJECT_DIR" \
  .env docker-*.yml build scripts

# Rotación: borrar copias de más de 14 días
find "$DEST" -name 'ia-*.tar.gz' -mtime +14 -delete

echo "Copias creadas en $DEST:"
ls -lh "$DEST" | tail -n 5
```

