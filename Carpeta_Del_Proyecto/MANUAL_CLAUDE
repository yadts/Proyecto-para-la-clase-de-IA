### 3.6. `docker-openwebui.yml`

```yaml
name: ia-openwebui

services:
  openwebui:
    image: ghcr.io/open-webui/open-webui:${OPENWEBUI_TAG:-cuda}
    container_name: openwebui
    restart: unless-stopped
    ports:
      - "${OPENWEBUI_PORT:-3000}:8080"
    volumes:
      - ${DATA_DIR}/openwebui:/app/backend/data
    environment:
      TZ: ${TZ}
      WEBUI_NAME: ${WEBUI_NAME}
      WEBUI_SECRET_KEY: ${WEBUI_SECRET_KEY}
      ENABLE_SIGNUP: ${ENABLE_SIGNUP:-true}
      # --- Ollama ---
      ENABLE_OLLAMA_API: "true"
      OLLAMA_BASE_URL: http://ollama:11434
      # --- Búsqueda web con SearXNG ---
      ENABLE_WEB_SEARCH: "true"
      WEB_SEARCH_ENGINE: searxng
      SEARXNG_QUERY_URL: http://searxng:8080/search?q=<query>
      # --- Generación de imágenes con ComfyUI ---
      ENABLE_IMAGE_GENERATION: "true"
      IMAGE_GENERATION_ENGINE: comfyui
      COMFYUI_BASE_URL: http://comfyui:8188
      # --- RAG: Qdrant como base vectorial, Ollama para embeddings ---
      VECTOR_DB: qdrant
      QDRANT_URI: http://rag:6333
      QDRANT_API_KEY: ${RAG_API_KEY}
      RAG_EMBEDDING_ENGINE: ollama
      RAG_EMBEDDING_MODEL: ${OLLAMA_EMBED_MODEL}
      RAG_OLLAMA_BASE_URL: http://ollama:11434
      NVIDIA_VISIBLE_DEVICES: all
      NVIDIA_DRIVER_CAPABILITIES: compute,utility
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    networks:
      - red-ia

networks:
  red-ia:
    external: true
    name: red-ia
```

> Estas variables fijan la configuración **la primera vez** que arranca Open WebUI. Después, Open WebUI guarda los ajustes en su base de datos y los cambios se hacen desde *Panel de administración → Ajustes*. Si necesita que el valor de una variable vuelva a mandar, añada `ENABLE_PERSISTENT_CONFIG: "false"`.

### 3.7. `docker-hermes-agent.yml`

```yaml
name: ia-hermes-agent

services:
  hermes-agent:
    image: nousresearch/hermes-agent:${HERMES_TAG:-latest}
    container_name: hermes-agent
    restart: unless-stopped
    command: gateway run
    ports:
      - "${HERMES_PORT:-8000}:8000"
    volumes:
      - ${DATA_DIR}/hermes:/opt/data
    environment:
      TZ: ${TZ}
      # Motor LLM: Ollama mediante su API compatible con OpenAI
      OPENAI_BASE_URL: http://ollama:11434/v1
      OPENAI_API_KEY: ollama
      # Servidor API del agente (ver nota en la sección 6.5 si cambia en su versión)
      API_SERVER_ENABLED: "true"
      API_SERVER_HOST: 0.0.0.0
      API_SERVER_PORT: "8000"
      API_SERVER_KEY: ${HERMES_API_KEY}
    networks:
      red-ia:
        aliases:
          - hermesagent

networks:
  red-ia:
    external: true
    name: red-ia
```

### 3.8. `docker-opencode.yml`

```yaml
name: ia-opencode

services:
  opencode:
    build:
      context: ./build/opencode
      args:
        OPENCODE_VERSION: ${OPENCODE_VERSION:-latest}
    image: ia/opencode:local
    container_name: opencode
    restart: unless-stopped
    working_dir: /workspace
    command: ["web", "--hostname", "0.0.0.0", "--port", "8080"]
    ports:
      - "${OPENCODE_PORT:-8443}:8080"
    volumes:
      - ${DATA_DIR}/opencode/workspace:/workspace
      - ${DATA_DIR}/opencode/config:/root/.config/opencode
      - ${DATA_DIR}/opencode/share:/root/.local/share/opencode
    environment:
      TZ: ${TZ}
      OPENCODE_SERVER_USERNAME: ${OPENCODE_SERVER_USERNAME:-opencode}
      OPENCODE_SERVER_PASSWORD: ${OPENCODE_SERVER_PASSWORD}
    networks:
      - red-ia

networks:
  red-ia:
    external: true
    name: red-ia
```

> **Aviso:** el puerto 8443 se usa por convención de la especificación, pero **OpenCode sirve HTTP, no HTTPS**. Para exponerlo fuera de su red local debe ponerle delante un proxy inverso con TLS (Caddy, Nginx o Traefik).

### 3.9. Ficheros de construcción (Dockerfile)

Tres servicios no tienen una imagen oficial lista para usar con la configuración que necesitamos y se construyen localmente.

**`~/proyecto/build/comfyui/Dockerfile`**

```dockerfile
ARG PYTORCH_IMAGE=pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime
FROM ${PYTORCH_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends git libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN git clone --depth 1 https://github.com/comfyanonymous/ComfyUI.git . \
 && pip install --no-cache-dir -r requirements.txt

EXPOSE 8188
CMD ["python", "main.py", "--listen", "0.0.0.0", "--port", "8188"]
```

**`~/proyecto/build/opencode/Dockerfile`**

```dockerfile
FROM node:22-bookworm-slim

ARG OPENCODE_VERSION=latest
RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g opencode-ai@${OPENCODE_VERSION}

WORKDIR /workspace
EXPOSE 8080
ENTRYPOINT ["opencode"]
CMD ["web", "--hostname", "0.0.0.0", "--port", "8080"]
```

Se incluye `git` porque la interfaz web de OpenCode lo necesita para trabajar con proyectos, y `node` porque algunas integraciones (servidores MCP, sección 7.7) se ejecutan con `npx`.

