```

### 2.2. Crear los directorios

```bash
# Configuración del stack
mkdir -p ~/proyecto/{build/opencode,build/comfyui,build/yolo/app,scripts,backups}

# Datos persistentes (volúmenes)
mkdir -p ~/ollama ~/openwebui ~/hermes
mkdir -p ~/opencode/{workspace,config,share}
mkdir -p ~/comfyui/{input,output,user,custom_nodes}
mkdir -p ~/comfyui/models/{checkpoints,loras,vae,controlnet,clip,unet,diffusion_models,text_encoders,embeddings,upscale_models}
mkdir -p ~/yolo/{models,dataset}
mkdir -p ~/searxng/{config,data}
mkdir -p ~/rag/{storage,docs}

# Comprobar
find ~/proyecto -maxdepth 2 -type d | sort
```

