    name: red-ia
```

### 3.4. `docker-comfyui.yml`

```yaml
name: ia-comfyui

services:
  comfyui:
    build:
      context: ./build/comfyui
      args:
        PYTORCH_IMAGE: ${COMFYUI_PYTORCH_IMAGE}
    image: ia/comfyui:local
    container_name: comfyui
    restart: unless-stopped
    command: python main.py --listen 0.0.0.0 --port 8188 ${COMFYUI_EXTRA_ARGS:-}
