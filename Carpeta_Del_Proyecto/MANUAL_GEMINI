3. Fichero de Entorno (.env)

Crea el archivo $HOME/proyecto/.env para definir las variables comunes de red, puertos y rutas de datos:

# Variables Generales de Red y Sistema
PROJECT_NAME=pila-ia
DOCKER_NETWORK=red-ia
DATA_BASE_DIR=/home/usuario/proyecto

# Ollama
OLLAMA_PORT_HOST=11434
OLLAMA_PORT_CONTAINER=11434

# Open WebUI
OPENWEBUI_PORT_HOST=3000
OPENWEBUI_PORT_CONTAINER=8080

# Hermes Agent
HERMES_PORT_HOST=8000
HERMES_PORT_CONTAINER=8000

# OpenCode
OPENCODE_PORT_HOST=8443
OPENCODE_PORT_CONTAINER=8080

# ComfyUI
COMFYUI_PORT_HOST=8188
COMFYUI_PORT_CONTAINER=8188

# YOLO API
YOLO_PORT_HOST=5000
YOLO_PORT_CONTAINER=5000

# SearXNG
SEARXNG_PORT_HOST=8080
SEARXNG_PORT_CONTAINER=8080
SEARXNG_SECRET_KEY=clave_secreta_super_segura_searxng_2026

# RAG
RAG_PORT_HOST=11435
RAG_PORT_CONTAINER=11434


Nota: Reemplaza /home/usuario/proyecto en DATA_BASE_DIR por la ruta absoluta real de tu directorio home.

4. Ficheros de Configuración Docker Compose

Crearemos un archivo .yml por cada servicio dentro de la carpeta $HOME/proyecto/compose/. Todos compartirán la red red-ia.

4.1. Red Común

Antes de desplegar los servicios, crearemos la red externa Docker en modo bridge:

docker network create red-ia


4.2. docker-ollama.yml

version: '3.8'

networks:
  red-ia:
    external: true

services:
  ollama:
    image: ollama/ollama:latest
    container_name: ollama
    restart: unless-stopped
    ports:
      - "${OLLAMA_PORT_HOST}:${OLLAMA_PORT_CONTAINER}"
    volumes:
      - ${DATA_BASE_DIR}/ollama:/root/.ollama
    networks:
      - red-ia
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]


4.3. docker-openwebui.yml

version: '3.8'

networks:
  red-ia:
    external: true

services:
  openwebui:
    image: ghcr.io/open-webui/open-webui:main
    container_name: openwebui
    restart: unless-stopped
    ports:
      - "${OPENWEBUI_PORT_HOST}:${OPENWEBUI_PORT_CONTAINER}"
    environment:
      - OLLAMA_BASE_URL=http://ollama:11434
      - ENABLE_RAG_WEB_SEARCH=True
      - RAG_WEB_SEARCH_ENGINE=searxng
      - SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>
    volumes:
      - ${DATA_BASE_DIR}/openwebui:/app/backend/data
    networks:
      - red-ia
    depends_on:
      - ollama


4.4. docker-hermes-agent.yml

version: '3.8'

networks:
